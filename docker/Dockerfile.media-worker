FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/worker/requirements/base.txt ./requirements/base.txt
RUN pip install --no-cache-dir -r requirements/base.txt

COPY apps/worker/infra ./infra
COPY apps/worker/config ./config
COPY apps/worker/pipelines/ffmpeg.py ./pipelines/ffmpeg.py
COPY apps/worker/schemas ./schemas
COPY apps/worker/workers/base.py ./workers/base.py
COPY apps/worker/workers/media.py ./workers/media.py
COPY apps/worker/main.py ./main.py

CMD ["python", "main.py"]