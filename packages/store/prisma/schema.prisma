generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OAuthType {
  GOOGLE
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum Stage {
  MEDIA
  TRANSCRIPTION
  OCR
  NOTES
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model User {
  id             String  @id @default(uuid())
  name           String
  email          String
  profilePicture String?

  oauthType OAuthType
  oauthId   String

  videos Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([oauthType, oauthId])
}

model Video {
  id                String @id @default(uuid())
  title             String
  filename          String
  status            Status @default(PENDING)

  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id              String @id @default(uuid())
  videoId         String
  status          Status @default(PENDING)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  stageExecutions StageExecution[]
  artifacts       Artifact[]
  logs            Log[]

  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StageExecution {
  id      String @id @default(uuid())
  jobId   String
  stage   Stage
  status  Status @default(PENDING)
  attempt Int    @default(0)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, stage])
}

model Artifact {
  id          String  @id @default(uuid())
  jobId       String
  stage       Stage
  objectKey   String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Log {
  id      String   @id @default(uuid())
  jobId   String
  stage   Stage?
  level   LogLevel
  message String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}